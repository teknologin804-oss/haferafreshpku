# -----------------------------------------------------------------------------
# HAFERA FRESH — contoh konfigurasi. Salin menjadi .env.local untuk pengembangan.
# File .env.local TIDAK boleh di-commit.
# -----------------------------------------------------------------------------

# Nomor WhatsApp resmi sudah terpasang sebagai default di src/config/site.ts
# (6285839025704). Biarkan kosong untuk memakai nomor tersebut, atau isi untuk
# merotasi nomor tanpa mengubah kode. Format: kode negara tanpa +/spasi.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL publik website. Wajib diisi saat deploy agar canonical, sitemap, dan
# Open Graph menunjuk ke domain yang benar. Tanpa http://localhost, tanpa slash.
NEXT_PUBLIC_SITE_URL=

# Opsional: alamat email bisnis bila sudah tersedia.
NEXT_PUBLIC_CONTACT_EMAIL=
